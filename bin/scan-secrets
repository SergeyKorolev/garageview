#!/usr/bin/env ruby
require "fileutils"
require "open3"
require "tmpdir"

root = File.expand_path("..", __dir__)
Dir.chdir(root) do
  scanner = ENV.fetch("GITLEAKS_BIN", "gitleaks")
  config = File.join(root, ".gitleaks.toml")
  flags = [ "--config", config, "--redact=100", "--no-banner" ]
  history_ok = system(scanner, "git", "--log-opts=--all --full-history", *flags, root)
  paths, status = Open3.capture2("git", "ls-files", "--cached", "--others", "--exclude-standard", "-z")
  abort "Could not enumerate repository files" unless status.success?
  current_ok = Dir.mktmpdir("garageview-secret-scan-") do |directory|
    paths.split("\0").uniq.each do |path|
      next unless File.file?(path)
      abort "Review symlink before scanning: #{path}" if File.symlink?(path)
      destination = File.join(directory, path)
      FileUtils.mkdir_p(File.dirname(destination))
      FileUtils.cp(path, destination)
    end
    system(scanner, "dir", *flags, directory)
  end
  abort "Secret scan failed. Inspect redacted findings; do not suppress real credentials." unless history_ok && current_ok
end
