#!/bin/sh
set -eu
# Linux CI/container installer. Use Hugo's official package on macOS.
destination=${1:?Usage: bin/install-hugo /absolute/destination}
case "$(uname -m)" in
  x86_64) architecture=amd64; checksum=5c3a37a5450b3e386e5b75a87a790fea2d04a796d75e171216c80ef48a32b432 ;;
  aarch64|arm64) architecture=arm64; checksum=65c9fdd75e82d5f1eaf565f6e9fede6c0ceecaa267798e10c73068986996b77d ;;
  *) echo 'Unsupported Hugo build architecture' >&2; exit 1 ;;
esac
archive=$(mktemp)
trap 'rm -f "$archive"' EXIT
curl -fsSL "https://github.com/gohugoio/hugo/releases/download/v0.165.0/hugo_0.165.0_linux-${architecture}.tar.gz" -o "$archive"
printf '%s  %s\n' "$checksum" "$archive" | sha256sum -c -
mkdir -p "$destination"
tar -xzf "$archive" -C "$destination" hugo
