# Kamal secrets — copy to .kamal/secrets and fill in real values
# This file is sourced as a shell script at deploy time
#
# Usage: cp .kamal/secrets.sample .kamal/secrets
# Then edit .kamal/secrets with your actual values

# Docker Hub credentials
KAMAL_REGISTRY_PASSWORD=your_dockerhub_token

# Rails
SECRET_KEY_BASE=generate_with_bin/rails_secret

# Database (password used by both PostgreSQL accessory and DATABASE_URL)
POSTGRES_PASSWORD=generate_a_strong_password
DATABASE_URL="postgresql://garageview:$POSTGRES_PASSWORD@garageview-db:5432/garageview_production"

# Redis (password used by both Redis accessory and REDIS_URL)
REDIS_PASSWORD=generate_a_strong_password
REDIS_URL="redis://:$REDIS_PASSWORD@garageview-redis:6379/0"

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# OpenAI
OPENAI_API_KEY_PRODUCTION=your_openai_api_key

# Mobile.de scraping (Apify)
MOBILE_DE_SCRAPER_API_URL=https://api.apify.com/v2
MOBILE_DE_SCRAPER_API_KEY=your_apify_api_key

# Email (Mailtrap production)
MAILTRAP_API_TOKEN=your_mailtrap_api_token
MAILTRAP_WELCOME_TEMPLATE_UUID=your_welcome_template_uuid
MAILTRAP_DELETED_TEMPLATE_UUID=your_deleted_template_uuid
MAILTRAP_COLLECTION_INVITE_TEMPLATE_UUID=your_collection_invite_template_uuid
