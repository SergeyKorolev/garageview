<div style="min-height: 100vh; background-color: #0b1120; color: #e5e7eb; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px 24px;">
  <div style="max-width: 520px; width: 100%; text-align: center;">
    <%# Logo %>
    <a href="/" style="text-decoration: none;">
      <img src="/logo.png?v=2" alt="GarageView.ai" style="height: 32px; margin-bottom: 40px;" width="114" height="32" />
    </a>

    <%# Invite header %>
    <div style="margin-bottom: 32px;">
      <div style="font-size: 13px; color: #6b7280; margin-bottom: 8px;">
        <%= @owner.name %> invited you to compare cars together
      </div>
      <h1 style="font-size: 28px; font-weight: 800; color: white; margin: 0; line-height: 1.2;">
        <%= @collection.name %>
      </h1>
      <div style="font-size: 14px; color: #9ca3af; margin-top: 8px;">
        <%= @cars_count %> car<%= @cars_count == 1 ? "" : "s" %>
        <% if @ai_rated_count > 0 %>
          &middot; AI rated
        <% end %>
      </div>
    </div>

    <%# Car photo grid %>
    <% if @cars.any? %>
      <div style="display: grid; grid-template-columns: repeat(<%= [@cars.size, 3].min %>, 1fr); gap: 8px; margin-bottom: 32px;">
        <% @cars.each do |car| %>
          <div style="border-radius: 10px; overflow: hidden; aspect-ratio: 4/3; background-color: #1f2937;">
            <% if car.photos&.first %>
              <img src="<%= car.photos.first %>" alt="" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# Car names preview %>
    <% if @cars.any? %>
      <div style="margin-bottom: 32px; text-align: left;">
        <% @cars.first(4).each do |car| %>
          <div style="display: flex; align-items: center; gap: 10px; padding: 8px 12px; border-bottom: 1px solid #1f2937;">
            <div style="font-size: 13px; color: #d1d5db; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; flex: 1;">
              <%= car.title %>
            </div>
            <div style="font-size: 13px; font-weight: 700; color: #60a5fa; flex-shrink: 0;">
              <%= car.price_cents ? number_to_currency(car.price_cents / 100.0, unit: "\u20AC", precision: 0, format: "%n %u") : "" %>
            </div>
          </div>
        <% end %>
        <% if @cars_count > 4 %>
          <div style="padding: 8px 12px; font-size: 12px; color: #6b7280;">
            + <%= @cars_count - 4 %> more car<%= @cars_count - 4 == 1 ? "" : "s" %>
          </div>
        <% end %>
      </div>
    <% end %>

    <%# CTA %>
    <% if @already_member %>
      <a href="/collections/<%= @collection.id %>" style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: #22c55e; border-radius: 12px; text-decoration: none; box-shadow: 0 4px 24px rgba(34,197,94,0.3);">
        Open Collection
      </a>
      <div style="font-size: 12px; color: #6b7280; margin-top: 12px;">You already have access to this collection</div>
    <% elsif user_signed_in? %>
      <form action="/s/j/<%= @collection.compare_token %>/join" method="post" style="display: inline;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
        <button type="submit" style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: #22c55e; border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 4px 24px rgba(34,197,94,0.3);">
          Join as <%= @collection.compare_role || "viewer" %>
        </button>
      </form>
    <% else %>
      <form action="/s/j/<%= @collection.compare_token %>/join" method="post" style="display: inline;">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
        <button type="submit" style="display: inline-flex; align-items: center; gap: 12px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: #2563eb; border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 4px 24px rgba(37,99,235,0.4);">
          <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          Sign in with Google to join
        </button>
      </form>
    <% end %>

    <%# Info line %>
    <div style="margin-top: 24px; font-size: 12px; color: #4b5563;">
      You'll join as <strong style="color: #9ca3af;"><%= @collection.compare_role || "viewer" %></strong> &middot;
      <a href="/en" style="color: #6b7280; text-decoration: underline;">What is Garageview?</a>
    </div>
  </div>
</div>
