<div style="min-height: 100vh; background-color: #0b1120; color: #e5e7eb;">
  <%# Header %>
  <header style="padding: 20px 24px; display: flex; align-items: center; justify-content: space-between; max-width: 1100px; margin: 0 auto;">
    <a href="/" style="text-decoration: none;">
      <img src="/logo.png?v=2" alt="GarageView.ai" style="height: 32px;" width="114" height="32" />
    </a>
    <a href="/en" style="font-size: 13px; color: #22c55e; text-decoration: none; font-weight: 600; padding: 8px 20px; border: 1px solid #22c55e; border-radius: 8px;">
      Create your own collection
    </a>
  </header>

  <main style="max-width: 1100px; margin: 0 auto; padding: 20px 24px 80px;">
    <%# Collection header %>
    <div style="margin-bottom: 32px;">
      <div style="font-size: 12px; color: #6b7280; margin-bottom: 6px;">
        Shared by <%= @owner.name %>
      </div>
      <h1 style="font-size: 28px; font-weight: 800; color: white; margin: 0 0 8px; line-height: 1.2;">
        <%= @collection.name %>
      </h1>
      <div style="display: flex; gap: 16px; font-size: 13px; color: #9ca3af;">
        <span><%= @cars_count %> car<%= @cars_count == 1 ? "" : "s" %></span>
        <% if @ai_rated %>
          <span style="color: #22c55e;">AI Rated</span>
        <% end %>
        <% if @research_count > 0 %>
          <span><%= @research_count %> deep research<%= @research_count == 1 ? "" : "es" %></span>
        <% end %>
      </div>
    </div>

    <%# Car grid %>
    <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(min(340px, 100%), 1fr)); gap: 16px;">
      <% @cars.each do |entry| %>
        <% car = entry[:car] %>
        <% ai_rating = entry[:ai_rating] %>
        <% ai_explanation = entry[:ai_explanation] %>
        <div style="border-radius: 12px; border: 1px solid #1f2937; overflow: hidden; background-color: #111827;">
          <%# Photo %>
          <div style="position: relative; aspect-ratio: 16/10; background-color: #1f2937;">
            <% if car.photos&.first %>
              <img src="<%= car.photos.first %>" alt="" style="width: 100%; height: 100%; object-fit: cover;" loading="lazy" />
            <% end %>
            <% if ai_rating %>
              <div style="position: absolute; top: 10px; right: 10px; background-color: <%= ai_rating == 1 ? '#22c55e' : ai_rating <= 3 ? '#3b82f6' : '#4b5563' %>; color: white; font-size: 12px; font-weight: 800; padding: 4px 10px; border-radius: 6px;">
                #<%= ai_rating %>
              </div>
            <% end %>
          </div>

          <%# Content %>
          <div style="padding: 14px 16px;">
            <%# Title + Price row %>
            <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; margin-bottom: 8px;">
              <div style="font-size: 14px; font-weight: 700; color: #e5e7eb; line-height: 1.3; flex: 1; min-width: 0;">
                <%= car.title %>
              </div>
              <div style="font-size: 15px; font-weight: 800; color: #60a5fa; white-space: nowrap; flex-shrink: 0;">
                <%= car.price_cents ? number_to_currency(car.price_cents / 100.0, unit: "\u20AC", precision: 0, format: "%n %u") : "" %>
              </div>
            </div>

            <%# Specs row %>
            <div style="display: flex; gap: 8px; flex-wrap: wrap; font-size: 12px; color: #6b7280; margin-bottom: 10px;">
              <% if car.mileage_km %>
                <span><%= number_with_delimiter(car.mileage_km) %> km</span>
              <% end %>
              <% if car.first_registration.present? %>
                <span>&middot; <%= car.first_registration %></span>
              <% end %>
              <% if car.power_kw %>
                <span>&middot; <%= car.power_kw %> kW (<%= (car.power_kw * 1.36).round %> PS)</span>
              <% end %>
              <% if car.fuel_type.present? %>
                <span>&middot; <%= car.fuel_type %></span>
              <% end %>
              <% if car.transmission.present? %>
                <span>&middot; <%= car.transmission %></span>
              <% end %>
            </div>

            <%# Seller %>
            <div style="font-size: 11px; color: #4b5563; margin-bottom: 10px;">
              <%= [car.seller_name, car.seller_address].compact.reject(&:blank?).join(" &middot; ").html_safe %>
            </div>

            <%# AI verdict (if rated) %>
            <% if ai_explanation && ai_explanation["verdict"].present? %>
              <div style="font-size: 12px; color: #9ca3af; line-height: 1.5; padding: 10px 12px; border-radius: 8px; background-color: rgba(34,197,94,0.06); border: 1px solid rgba(34,197,94,0.15);">
                <span style="color: #22c55e; font-weight: 600;">AI:</span> <%= ai_explanation["verdict"].truncate(200) %>
              </div>
            <% end %>

            <%# Pros/Cons (if rated) %>
            <% if ai_explanation && (ai_explanation["pros"]&.any? || ai_explanation["cons"]&.any?) %>
              <div style="margin-top: 8px; display: flex; gap: 12px;">
                <% if ai_explanation["pros"]&.any? %>
                  <div style="flex: 1;">
                    <% ai_explanation["pros"].first(2).each do |pro| %>
                      <div style="font-size: 11px; color: #34d399; margin-bottom: 2px;">+ <%= pro.truncate(60) %></div>
                    <% end %>
                  </div>
                <% end %>
                <% if ai_explanation["cons"]&.any? %>
                  <div style="flex: 1;">
                    <% ai_explanation["cons"].first(2).each do |con| %>
                      <div style="font-size: 11px; color: #f87171; margin-bottom: 2px;">&minus; <%= con.truncate(60) %></div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>

    <%# CTA %>
    <div style="margin-top: 48px; text-align: center; padding: 40px 24px; border-radius: 16px; border: 1px solid #1f2937; background: linear-gradient(135deg, rgba(34,197,94,0.05), rgba(37,99,235,0.05));">
      <div style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 10px;">
        Build your own car comparison
      </div>
      <div style="font-size: 15px; color: #9ca3af; margin-bottom: 24px; max-width: 500px; margin-left: auto; margin-right: auto;">
        Import cars from mobile.de, get AI ratings with pros, cons, and hidden concerns. Completely free.
      </div>
      <a href="/en" style="display: inline-flex; align-items: center; gap: 10px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: #22c55e; border: none; border-radius: 12px; text-decoration: none; box-shadow: 0 4px 24px rgba(34,197,94,0.3);">
        Get Started Free
      </a>
    </div>
  </main>

  <%# Footer %>
  <footer style="padding: 24px; text-align: center; border-top: 1px solid #1f2937;">
    <div style="font-size: 12px; color: #6b7280;">
      garageview.ai &middot; Built with AI in Europe &middot;
      <a href="/en/privacy" style="color: #6b7280; text-decoration: underline;">Privacy</a> &middot;
      <a href="/en/terms" style="color: #6b7280; text-decoration: underline;">Terms</a>
    </div>
  </footer>
</div>
