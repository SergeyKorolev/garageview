<!DOCTYPE html>
<html>
  <head>
    <title><%= @meta[:title] %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; color: #1f2937; line-height: 1.5; padding: 24px; max-width: 800px; margin: 0 auto; }
      h1 { font-size: 22px; font-weight: 800; margin-bottom: 4px; }
      h2 { font-size: 16px; font-weight: 700; margin-bottom: 10px; padding-bottom: 6px; border-bottom: 2px solid #e5e7eb; color: #111827; }
      h3 { font-size: 14px; font-weight: 700; color: #3b82f6; margin-bottom: 6px; }
      .section { margin-bottom: 24px; }
      .price { font-size: 20px; font-weight: 800; color: #2563eb; }
      .specs { display: flex; flex-wrap: wrap; gap: 6px; margin: 10px 0; }
      .spec-chip { padding: 3px 10px; border-radius: 4px; background: #f3f4f6; font-size: 12px; color: #4b5563; }
      .pro { color: #16a34a; font-size: 12px; margin-bottom: 2px; }
      .con { color: #dc2626; font-size: 12px; margin-bottom: 2px; }
      .flag { color: #d97706; font-size: 12px; margin-bottom: 2px; }
      .meta { font-size: 12px; color: #6b7280; }
      .two-col { display: flex; gap: 16px; }
      .two-col > div { flex: 1; min-width: 0; }
      table { width: 100%; border-collapse: collapse; font-size: 12px; }
      td { padding: 4px 8px; border-bottom: 1px solid #e5e7eb; }
      td:first-child { color: #6b7280; width: 40%; }
      .features { display: flex; flex-wrap: wrap; gap: 4px; }
      .feature { padding: 2px 8px; border-radius: 4px; background: #f3f4f6; font-size: 11px; color: #4b5563; }
      .ranking-badge { display: inline-flex; align-items: center; justify-content: center; width: 28px; min-width: 28px; height: 28px; min-height: 28px; border-radius: 50%; color: white; font-weight: 800; font-size: 13px; flex-shrink: 0; line-height: 1; }
      .rank-1 { background: #16a34a; }
      .rank-2 { background: #2563eb; }
      .rank-3 { background: #6b7280; }
      .footer { margin-top: 32px; padding-top: 12px; border-top: 1px solid #e5e7eb; font-size: 11px; color: #9ca3af; text-align: center; }
      @media print {
        body { padding: 0; }
        .no-print { display: none !important; }
        @page { margin: 1.5cm; }
      }
      .print-btn { display: inline-flex; align-items: center; gap: 6px; padding: 10px 24px; font-size: 14px; font-weight: 600; color: white; background: #2563eb; border: none; border-radius: 8px; cursor: pointer; margin-bottom: 24px; }
    </style>
  </head>
  <body>
    <div class="no-print" style="text-align: center; margin-bottom: 16px;">
      <button class="print-btn" onclick="window.print()">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9V2h12v7M6 18H4a2 2 0 01-2-2v-5a2 2 0 012-2h16a2 2 0 012 2v5a2 2 0 01-2 2h-2M6 14h12v8H6z"/></svg>
        Print / Save as PDF
      </button>
    </div>
    <%= yield %>
    <div class="footer">
      garageview.ai &middot; Generated <%= Date.today.strftime("%B %d, %Y") %>
    </div>
  </body>
</html>
