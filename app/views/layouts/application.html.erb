<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= @page_title || content_for(:title) || "Garageview.ai — Your AI car expert" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= @page_description || "Turns chaotic used-car listings from mobile.de into an AI-powered buying workspace. Store cars into collections, compare them side-by-side, spot red flags, and identify the best-value deal." %>">
    <meta name="keywords" content="used cars, mobile.de, AI car comparison, car buying, car analysis, vehicle comparison, car search, garageview">
    <meta name="author" content="Garageview.ai">
    <meta name="robots" content="<%= @page_noindex ? 'noindex, nofollow' : 'index, follow' %>">

    <!-- Open Graph -->
    <meta property="og:type" content="website">
    <meta property="og:title" content="<%= @page_title || "Garageview.ai — Your AI car expert" %>">
    <meta property="og:description" content="<%= @page_description || "Turns chaotic used-car listings from mobile.de into an AI-powered buying workspace. Compare cars side-by-side, spot red flags, and find the best deal." %>">
    <meta property="og:url" content="<%= @page_canonical || "https://garageview.ai" %>">
    <meta property="og:image" content="https://garageview.ai/og-image.png">
    <meta property="og:site_name" content="Garageview.ai">
    <meta property="og:locale" content="en_US">

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="<%= @page_title || "Garageview.ai — Your AI car expert" %>">
    <meta name="twitter:description" content="<%= @page_description || "AI-powered workspace for comparing used cars from mobile.de. Spot red flags, compare specs, find the best deal." %>">
    <meta name="twitter:image" content="https://garageview.ai/og-image.png">

    <!-- Canonical -->
    <link rel="canonical" href="<%= @page_canonical || "https://garageview.ai" %>">

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <!-- Cookie Consent (vanilla-cookieconsent v3) -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.css">
    <script src="https://cdn.jsdelivr.net/gh/orestbida/cookieconsent@3.1.0/dist/cookieconsent.umd.js" defer></script>

