<div style="min-height: 100vh; overflow-x: hidden;">
  <%# Hero — dark %>
  <section style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 100vh; padding: 60px 24px 40px; text-align: center; position: relative; background-color: #0b1120; color: #e5e7eb;">
    <img src="/logo.png?v=2" alt="GarageView.ai" style="height: 56px; max-width: 100%; object-fit: contain; margin-bottom: 60px;" width="290" height="56" />
    <h1 style="max-width: 1050px; font-size: clamp(28px, 7vw, 60px); font-weight: 800; line-height: 1.1; margin-bottom: 20px; letter-spacing: -0.03em; color: white;">
      <%= t_page("landing.hero") %>
    </h1>
    <p style="font-size: clamp(16px, 2vw, 20px); line-height: 1.6; max-width: 800px; margin-bottom: 40px; color: #9ca3af;">
      <%= t_page("landing.subtitle") %>
    </p>
    <div style="display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; margin-bottom: 28px;">
      <span style="font-size: 14px; color: #9ca3af;"><%= t_page("landing.supportedSources") %></span>
      <% [ "mobile.de", "AutoScout24", "Otomoto" ].each do |source| %>
        <span style="padding: 8px 16px; border: 1px solid #374151; border-radius: 999px; font-size: 15px; font-weight: 600; color: #e5e7eb;"><%= source %></span>
      <% end %>
    </div>
    <div style="display: flex; gap: 16px; align-items: center; flex-wrap: wrap; justify-content: center;">
      <form action="/users/auth/google_oauth2" method="post">
        <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
        <button type="submit" style="display: flex; align-items: center; gap: 12px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: #2563eb; border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 4px 24px rgba(37,99,235,0.4);">
          <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
          <%= t_page("landing.getStarted") %>
        </button>
      </form>
      <a href="https://chromewebstore.google.com/detail/garageviewai-%E2%80%94-your-ai-ca/ibifmbahobechmjhbpjbnieeladcgece" target="_blank" rel="noopener noreferrer" style="display: flex; align-items: center; gap: 10px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: transparent; border: 1px solid rgba(255,255,255,0.2); border-radius: 12px; text-decoration: none;">
        <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10" fill="none" stroke="currentColor" stroke-width="0"/><path d="M12 2a10 10 0 00-8.66 5h5.66l3-5.2A10 10 0 0012 2z" fill="#EA4335"/><path d="M3.34 7A10 10 0 002 12a10 10 0 005 8.66l2.83-4.9L6.34 7H3.34z" fill="#FBBC05"/><path d="M7 20.66A10 10 0 0012 22a10 10 0 008.66-5H15l-3 5.2a10 10 0 01-5-1.54z" fill="#34A853"/><path d="M20.66 17A10 10 0 0022 12a10 10 0 00-5-8.66l-2.83 4.9L17.66 17h3z" fill="#4285F4"/><circle cx="12" cy="12" r="4" fill="white"/><circle cx="12" cy="12" r="3.2" fill="#4285F4"/></svg>
        <%= t_page("landing.addToChrome") %>
      </a>
      <a href="/<%= @locale %>/guides/" style="display: inline-block; padding: 14px 28px; border: 1px solid #60a5fa; border-radius: 12px; color: #eff6ff; background-color: #172554; font-size: 16px; font-weight: 600; text-decoration: none;"><%= t_page("landing.guides") %></a>
    </div>

    <p style="max-width: 680px; margin: 20px 0 0; font-size: 13px; line-height: 1.6; color: #9ca3af;"><%= t_page("landing.importNote") %></p>

    <%# Static hero image (first carousel slide) %>
    <div style="margin-top: 60px; max-width: 1100px; width: 100%;">
      <div style="width: 100%; overflow: hidden; border-radius: 16px; box-shadow: 0 20px 60px rgba(0,0,0,0.5), 0 8px 24px rgba(0,0,0,0.3);">
        <img src="/screens/grid.png" alt="<%= t_page('landing.section1Label') %>" style="width: 100%; display: block;" loading="lazy" />
      </div>
    </div>
  </section>

  <%# Feature sections — light %>
  <div style="background-color: #f8f9fb;">
    <%
      sections = [
        { label: "landing.section1Label", title: "landing.section1Title", desc: "landing.section1Desc", desc2: "landing.section1Desc2", image: "/screens/detail.png" },
        { label: "landing.section4Label", title: "landing.section4Title", desc: "landing.section4Desc", desc2: "landing.section4Desc2", image: "/screens/notes.png" },
        { label: "landing.section3Label", title: "landing.section3Title", desc: "landing.section3Desc", desc2: "landing.section3Desc2", image: "/screens/map.png" },
        { label: "landing.section2Label", title: "landing.section2Title", desc: "landing.section2Desc", desc2: "landing.section2Desc2", image: "/screens/compare.png" },
      ]
    %>
    <% sections.each_with_index do |section, i| %>
      <% reversed = i.odd? %>
      <section style="max-width: 1200px; margin: 0 auto; padding: clamp(48px, 8vw, 100px) 24px; display: flex; flex-direction: <%= reversed ? 'row-reverse' : 'row' %>; align-items: center; gap: clamp(24px, 5vw, 60px); flex-wrap: wrap; <%= i < sections.length - 1 ? 'border-bottom: 1px solid #e5e7eb;' : '' %>">
        <div style="flex: 1 1 340px; min-width: 280px; text-align: left;">
          <div style="font-size: 12px; font-weight: 700; letter-spacing: 0.12em; color: #2563eb; margin-bottom: 12px; text-transform: uppercase;">
            <%= t_page(section[:label]) %>
          </div>
          <h2 style="font-size: clamp(28px, 3vw, 40px); font-weight: 800; line-height: 1.1; color: #111827; margin-bottom: 16px; letter-spacing: -0.02em;">
            <%= t_page(section[:title]) %>
          </h2>
          <p style="font-size: clamp(15px, 1.5vw, 18px); line-height: 1.7; color: #4b5563; margin-bottom: 12px;">
            <%= t_page(section[:desc]) %>
          </p>
          <p style="font-size: clamp(14px, 1.3vw, 16px); line-height: 1.7; color: #6b7280;">
            <%= t_page(section[:desc2]) %>
          </p>
        </div>
        <div style="flex: 1 1 500px; min-width: 300px; overflow: hidden; border-radius: 16px; box-shadow: 0 12px 48px rgba(0,0,0,0.15), 0 4px 16px rgba(0,0,0,0.08);">
          <img src="<%= section[:image] %>" alt="<%= t_page(section[:title]) %>" style="width: 100%; display: block; border-radius: 16px;" loading="lazy" />
        </div>
      </section>
    <% end %>
  </div>

  <%# Final CTA — dark %>
  <section style="display: flex; flex-direction: column; align-items: center; padding: clamp(48px, 8vw, 100px) 24px; text-align: center; background-color: #0b1120;">
    <h2 style="font-size: clamp(28px, 3.5vw, 48px); font-weight: 800; line-height: 1.1; color: white; margin-bottom: 16px; letter-spacing: -0.02em;">
      <%= t_page("landing.ctaTitle") %>
    </h2>
    <p style="font-size: 18px; color: #9ca3af; margin-bottom: 40px;">
      <%= t_page("landing.ctaSubtitle") %>
    </p>
    <form action="/users/auth/google_oauth2" method="post">
      <input type="hidden" name="authenticity_token" value="<%= form_authenticity_token %>" />
      <button type="submit" style="display: flex; align-items: center; gap: 12px; padding: 14px 36px; font-size: 16px; font-weight: 600; color: white; background-color: #2563eb; border: none; border-radius: 12px; cursor: pointer; box-shadow: 0 4px 24px rgba(37,99,235,0.4);">
        <svg style="width: 20px; height: 20px;" viewBox="0 0 24 24"><path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/><path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/><path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/><path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/></svg>
        <%= t_page("landing.getStarted") %>
      </button>
    </form>
  </section>

  <%# Footer %>
  <footer style="border-top: 1px solid rgba(255,255,255,0.06); padding: 32px 24px; text-align: center; background-color: #0b1120;">
    <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 6px 16px; margin-bottom: 16px;">
      <% PagesHelper::SUPPORTED_LOCALES.each do |loc| %>
        <a href="/<%= loc[:code] %>" style="font-size: 12px; text-decoration: none; color: <%= loc[:code] == @locale ? '#3b82f6' : '#6b7280' %>; font-weight: <%= loc[:code] == @locale ? '600' : '400' %>;">
          <%= loc[:label] %>
        </a>
      <% end %>
    </div>
    <div style="font-size: 13px; color: #6b7280;">
      garageview.ai &middot; <%= t_page("landing.footer") %>
      &middot; <a href="/<%= @locale %>/guides/" style="color: #9ca3af;"><%= t_page("landing.guides") %></a>
      &middot; <a href="/<%= @locale %>/privacy" style="color: #6b7280; text-decoration: none;">Privacy</a>
      &middot; <a href="/<%= @locale %>/terms" style="color: #6b7280; text-decoration: none;">Terms</a>
      &middot; <a href="mailto:support@garageview.ai" style="color: #6b7280; text-decoration: none;">support@garageview.ai</a>
    </div>
  </footer>
</div>
