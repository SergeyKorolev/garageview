# Local development only. Copy to .env; never commit real credentials.
# docker compose up -d db redis supplies these loopback-only services.
DATABASE_URL=postgresql://garageview:password@localhost:5432/garageview_development
REDIS_URL=redis://localhost:6379/0
APP_HOST=localhost:3000

# Optional Google sign-in. Email/password sign-in also works at /users/sign_in.
# Register http://localhost:3000/users/auth/google_oauth2/callback with Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional live imports through Apify (billable).
MOBILE_DE_SCRAPER_API_URL=https://api.apify.com/v2
MOBILE_DE_SCRAPER_API_KEY=

# Optional AI features (billable). No key needed for mocked tests or demo data.
OPENAI_API_KEY=

# Optional sandbox email. Without a username, development email stays in memory.
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

# Optional local admin creation with bin/rails db:seed; choose your own password.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional sample collection, using an existing locally registered user.
DEMO_USER_EMAIL=

# Production credentials belong in your secret manager / .kamal/secrets.
# Do not copy Garageview's production Rails master key into a development setup.
